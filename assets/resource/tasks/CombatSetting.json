        "CombatRotationOrder": {
            "type": "input",
            "label": "$setting_combat_rotation_order",
            "description": "$setting_combat_rotation_order_desc",
            "inputs": [
                {
                    "name": "rotation_order",
                    "label": "$setting_combat_rotation_order_input",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^$|^\\s*[1-4](\\s*[,，、]\\s*[1-4]){0,15}\\s*$",
                    "pattern_msg": "$setting_combat_rotation_order_pattern"
                }
            ],
            "pipeline_override": {
                "CombatSetting_RotationOrder": {
                    "attach": {
                        "rotation_order": "{rotation_order}"
                    }
                }
            }
        },
