        "CombatSpeed": {
            "type": "input",
            "label": "$setting_combat_speed",
            "description": "$setting_combat_speed_desc",
            "inputs": [
                {
                    "name": "combat_speed",
                    "label": "$setting_combat_speed_input",
                    "default": "1.0",
                    "pipeline_type": "string",
                    "verify": "^(0\\.[5-9]\\d?|1(\\.\\d{1,2})?|2(\\.0{1,2})?)$",
                    "pattern_msg": "$setting_combat_speed_pattern"
                }
            ],
            "pipeline_override": {
                "CombatSetting_Speed": {
                    "attach": {
                        "combat_speed": "{combat_speed}"
                    }
                }
            }
        },
        "CombatLockTarget": {
