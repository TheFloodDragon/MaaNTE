                {
                    "name": "4",
                    "label": "$setting_combat_team_size_4",
                    "pipeline_override": {
                        "CombatSetting_TeamSize": {
                            "attach": {
                                "team_size": 4
                            }
                        }
                    }
                },
                {
                    "name": "3",
                    "label": "$setting_combat_team_size_3",
                    "pipeline_override": {
                        "CombatSetting_TeamSize": {
                            "attach": {
                                "team_size": 3
                            }
                        }
                    }
                },
                {
                    "name": "2",
                    "label": "$setting_combat_team_size_2",
