        "CombatClearConfirm": {
            "type": "input",
            "label": "$setting_combat_clear_confirm",
            "description": "$setting_combat_clear_confirm_desc",
            "inputs": [
                {
                    "name": "clear_confirm",
                    "label": "$setting_combat_clear_confirm_input",
                    "default": "3",
                    "pipeline_type": "int",
                    "verify": "^([1-9]|[1-5][0-9]|60)$",
                    "pattern_msg": "$setting_combat_clear_confirm_pattern"
                }
            ],
            "pipeline_override": {
                "CombatSetting_ClearConfirm": {
                    "attach": {
                        "clear_confirm": "{clear_confirm}"
                    }
                }
            }
        },
        "CombatAdvanced": {
            "type": "switch",
            "label": "$setting_combat_advanced",
            "description": "$setting_combat_advanced_desc",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "$option_switch_case_yes",
                    "option": [
                        "CombatRotationMode",
                        "CombatRotationOrder",
                        "CombatFieldTime",
                        "CombatDisabledSlots",
                        "CombatSlot1",
                        "CombatSlot2",
                        "CombatSlot3",
                        "CombatSlot4"
                    ]
                },
                {
                    "name": "No",
                    "label": "$option_switch_case_no"
                }
            ]
        },
        "CombatRotationMode": {
            "type": "select",
            "label": "$setting_combat_rotation_mode",
            "description": "$setting_combat_rotation_mode_desc",
            "default_case": "inherit",
            "cases": [
                {
                    "name": "inherit",
                    "label": "$setting_combat_rotation_mode_inherit",
                    "pipeline_override": {
                        "CombatSetting_RotationMode": {
                            "attach": {
                                "rotation_mode": ""
                            }
                        }
                    }
                },
                {
                    "name": "cycle",
                    "label": "$setting_combat_rotation_mode_cycle",
                    "pipeline_override": {
                        "CombatSetting_RotationMode": {
                            "attach": {
                                "rotation_mode": "cycle"
                            }
