                    "pipeline_type": "string",
                    "verify": "^.{0,30}$"
                },
                {
                    "name": "slot1_combo",
                    "label": "$setting_combat_slot_combo",
                    "description": "$setting_combat_slot_combo_desc",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^.{0,500}$"
