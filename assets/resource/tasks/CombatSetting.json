{
    "option": {
        "CombatScheme": {
            "type": "select",
            "label": "$setting_combat_scheme",
            "description": "$setting_combat_scheme_desc",
            "default_case": "team_rotation",
            "cases": [
                {
                    "name": "team_rotation",
                    "label": "$setting_combat_scheme_team_rotation",
                    "pipeline_override": {
                        "CombatSetting_Scheme": {
                            "attach": {
                                "scheme": "team_rotation"
                            }
                        }
                    }
                },
                {
                    "name": "quick_swap",
                    "label": "$setting_combat_scheme_quick_swap",
                    "pipeline_override": {
                        "CombatSetting_Scheme": {
                            "attach": {
                                "scheme": "quick_swap"
                            }
                        }
                    }
                },
                {
                    "name": "main_dps",
                    "label": "$setting_combat_scheme_main_dps",
                    "pipeline_override": {
                        "CombatSetting_Scheme": {
                            "attach": {
                                "scheme": "main_dps"
                            }
                        }
                    }
                },
                {
                    "name": "support_burst",
                    "label": "$setting_combat_scheme_support_burst",
                    "pipeline_override": {
                        "CombatSetting_Scheme": {
                            "attach": {
                                "scheme": "support_burst"
                            }
                        }
                    }
                },
                {
                    "name": "dual_dps",
                    "label": "$setting_combat_scheme_dual_dps",
                    "pipeline_override": {
                        "CombatSetting_Scheme": {
                            "attach": {
                                "scheme": "dual_dps"
                            }
                        }
                    }
                },
                {
                    "name": "heavy_attack",
                    "label": "$setting_combat_scheme_heavy_attack",
                    "pipeline_override": {
                        "CombatSetting_Scheme": {
                            "attach": {
                                "scheme": "heavy_attack"
                            }
                        }
                    }
                },
                {
                    "name": "evasive",
                    "label": "$setting_combat_scheme_evasive",
                    "pipeline_override": {
                        "CombatSetting_Scheme": {
                            "attach": {
                                "scheme": "evasive"
                            }
                        }
                    }
                },
                {
                    "name": "solo_skill",
                    "label": "$setting_combat_scheme_solo_skill",
                    "pipeline_override": {
                        "CombatSetting_Scheme": {
                            "attach": {
                                "scheme": "solo_skill"
                            }
                        }
                    }
                },
                {
                    "name": "basic_attack",
                    "label": "$setting_combat_scheme_basic_attack",
                    "pipeline_override": {
                        "CombatSetting_Scheme": {
                            "attach": {
                                "scheme": "basic_attack"
                            }
                        }
                    }
                },
                {
                    "name": "custom",
                    "label": "$setting_combat_scheme_custom",
                    "pipeline_override": {
                        "CombatSetting_Scheme": {
                            "attach": {
                                "scheme": "custom"
                            }
                        }
                    },
                    "option": [
                        "CombatCustomScheme"
                    ]
                }
            ]
        },
        "CombatCustomScheme": {
            "type": "input",
            "label": "$setting_combat_custom_scheme",
            "description": "$setting_combat_custom_scheme_desc",
            "inputs": [
                {
                    "name": "custom_scheme",
                    "label": "$setting_combat_custom_scheme_input",
                    "default": "custom_example.json",
                    "pipeline_type": "string",
                    "verify": "^[^<>|?*]+$"
                }
            ],
            "pipeline_override": {
                "CombatSetting_CustomScheme": {
                    "attach": {
                        "custom_scheme": "{custom_scheme}"
                    }
                }
            }
        },
        "CombatTeamSize": {
