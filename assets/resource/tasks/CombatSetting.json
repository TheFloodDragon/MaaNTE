            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "$option_switch_case_yes",
                    "pipeline_override": {
                        "CombatSetting_LockTarget": {
                            "attach": {
                                "lock_target": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "$option_switch_case_no",
                    "pipeline_override": {
                        "CombatSetting_LockTarget": {
                            "attach": {
                                "lock_target": false
                            }
                        }
                    }
                }
