        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "DungeonFarmEntryGate"
        ],
        "on_error": [
            "DungeonFarmFail"
        ]
    },
    "DungeonFarmEntryGate": {
        "desc": "详情复核为目标后，首次读余额冻结预算；读不到余额或预算不足一次领取都不进入战斗",
