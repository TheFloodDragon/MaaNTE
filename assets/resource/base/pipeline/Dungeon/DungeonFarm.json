{
    // 刷本主流程（未实机校准）。识别节点见 DungeonStatus.json，profile 目录与模板见 DungeonProfiles.json。
    // 入场前、领奖前、再次挑战前三处体力闸门；40/80 由同帧按钮文字与成本数字关联，只有 DungeonFarmClaim 一个消费动作。
    // 所有可执行节点显式 rate_limit / pre_delay / post_delay = 0，不用节点 timeout 推进流程。
    "DungeonFarm_RunsOption": {
        "desc": "选项载体：成功领奖轮数上限（0 = 不限，仍受预算 / 保留线约束）",
        "enabled": false,
        "attach": {
            "runs": "0"
        }
    },
    "DungeonFarm_StageOption": {
        "desc": "选项载体：副本 profile id；cost 仅兼容旧配置，只接受 40",
        "enabled": false,
        "attach": {
            "name": "clock_trick",
            "cost": 40
        }
    },
    "DungeonFarm_TypeOption": {
        "desc": "选项载体：副本类型 id，须与 profile.type_id 一致",
        "enabled": false,
        "attach": {
            "type_id": "anomaly_domain"
        }
    },
    "DungeonFarm_EntranceOption": {
        "desc": "选项载体：副本入口 id，须与 profile.entrance_id 一致",
        "enabled": false,
        "attach": {
            "entrance_id": "rabbithole"
        }
    },
    "DungeonFarm_PlanOption": {
        "desc": "选项载体：体力计划 exhaust（用完本次预算）/ reserve（保留指定值）",
        "enabled": false,
        "attach": {
            "mode": "exhaust"
        }
    },
    "DungeonFarm_ReserveOption": {
        "desc": "选项载体：至少保留的本性像素（仅 reserve 计划生效）",
        "enabled": false,
        "attach": {
            "reserve": "0"
        }
    },
    "DungeonFarm_RewardOption": {
        "desc": "选项载体：单次领取消耗策略 40 / 80 / auto",
        "enabled": false,
        "attach": {
            "reward_mode": "40"
        }
    },
    "DungeonFarm_TeamOption": {
        "desc": "选项载体：队伍策略，目前只支持沿用当前队伍",
        "enabled": false,
        "attach": {
            "team_mode": "current"
        }
    },
    "DungeonFarmMain": {
        "desc": "入口：解析选项与 profile、整节点注入所选副本识别/路线，重建计次；配置错误在任何输入前失败",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "dungeon_reset"
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "DungeonFarmStart"
        ],
        "on_error": [
            "DungeonFarmFail"
        ]
    },
    "DungeonFarmStart": {
        "desc": "起点分类：先拒绝接管非本任务的战斗/关卡/领奖/结算，再从目标列表、入口或大世界开始",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "DungeonFarmUnsafeStart",
            "DungeonFarmEntryGate",
            "DungeonFarmSelectStage",
            "DungeonFarmEnterEntrance",
            "DungeonFarmTeleport",
            "DungeonFarmStartFromMenu"
        ],
        "on_error": [
            "DungeonFarmFail"
        ]
    },
    "DungeonFarmUnsafeStart": {
        "desc": "非本任务发起的战斗、关卡、奖励或结算：不接管，报告后失败",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "CombatEnemyVisible",
                    "DungeonEnemyCounter",
                    "DungeonRewardPrompt",
                    "DungeonRewardPopup",
                    "DungeonSettlement"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "dungeon_fail",
                "custom_action_param": {
                    "reason": "unsafe_start"
                }
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "DungeonFarmStartFromMenu": {
        "desc": "只在已识别的菜单内调用公共回世界接口，不对未知画面盲按 Esc",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "InEscMenu",
                    "InBagMenu",
                    "InExplorationGuideMenu"
                ]
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "DungeonFarmUnsafeStart",
            "DungeonFarmTeleport",
            "[JumpBack]SceneAnyEnterWorld"
        ],
        "on_error": [
            "DungeonFarmFail"
        ]
    },
    "DungeonFarmTeleport": {
        "desc": "未校准：在大世界按 profile 传送点打开地图索引传送（兔子洞 worldX/Y 为占位 0，不作寻路坐标）；传送完成不等于到达，须再识别入口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWorld"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "map_teleport_to_point",
                "custom_action_param": {
                    "teleport_point_id": "rabbithole"
                }
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "DungeonFarmEnterEntrance",
            "[JumpBack]SceneLoadingType1",
            "[JumpBack]SceneLoadingType2",
            "DungeonFarmWalkToEntrance"
        ],
        "on_error": [
            "DungeonFarmFail"
        ]
    },
    "DungeonFarmWalkToEntrance": {
        "desc": "未校准历史路线：仅在大世界有界按住 W，入口提示出现即松键；战斗/加载/弹窗立即松键交还识别；没有校准的进展锚点",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWorld"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "dungeon_walk_until",
                "custom_action_param": {
                    "key": "W",
                    "until": "DungeonEntrancePrompt",
                    "guard": "InWorld",
                    "abort_nodes": [
                        "CombatEnemyVisible",
                        "DungeonEnemyCounter",
                        "DungeonRewardPopup",
                        "SceneLoadingType1",
                        "SceneLoadingType2"
                    ],
                    "timeout": 15
                }
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "DungeonFarmEnterEntrance"
        ],
        "on_error": [
            "DungeonFarmFail"
        ]
    },
    "DungeonFarmEnterEntrance": {
        "desc": "大世界看到 profile 入口提示：按一次 F，再识别副本选择界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWorld",
                    "DungeonEntrancePrompt"
                ]
            }
        },
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 70
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "DungeonFarmEntryGate",
            "DungeonFarmSelectStage",
            "[JumpBack]SceneLoadingType1",
            "[JumpBack]SceneLoadingType2"
        ],
        "on_error": [
            "DungeonFarmFail"
        ]
    },
    "DungeonFarmSelectStage": {
        "desc": "副本选择界面：点击 profile 绑定的目标列表项；难度沿用游戏当前选择",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
