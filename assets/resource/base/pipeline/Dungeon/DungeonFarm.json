                    "phase": "claim",
                    "popup_node": "DungeonRewardPopup",
                    "balance_node": "DungeonBalance",
                    "options_node": "DungeonRewardOptions",
                    "buttons": {
                        "40": "DungeonClaimButton",
                        "80": "DungeonClaim80Button"
                    },
                    "continue": [
