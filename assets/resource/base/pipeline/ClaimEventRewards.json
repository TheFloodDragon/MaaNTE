    "ClaimEventRewardsPageReady": {
        "desc": "正面验证活动页后初始化本次七格子流程；边界扫描确认目标后也可从此节点进入",
        "recognition": {
            "type": "And",
            "param": {"all_of": ["ClaimEventRewardsPageIdentity"]}
