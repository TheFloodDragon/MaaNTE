{
    "ClaimEventRewardsEntrance": {
        "desc": "七日登录领奖入口；每次重置本次导航与领取结果锚点，不持久化日期、账号或领取次数",
        "recognition": {"type": "DirectHit"},
        "anchor": {
            "ClaimEventRewardsNavigation": "ClaimEventRewardsNavigateToEvents",
            "ClaimEventRewardsWorldNavigation": "",
            "ClaimEventRewardsOutcome": "ClaimEventRewardsNoReward",
            "ClaimEventRewardsClaimConfirmation": ""
        },
        "focus": {"Node.Action.Succeeded": "$claim_event_rewards_started"},
        "next": [
            "ClaimEventRewardsInMenu",
            "[JumpBack][Anchor]ClaimEventRewardsNavigation"
        ],
        "on_error": ["ClaimEventRewardsFailed"],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "ClaimEventRewardsNavigateToEvents": {
        "desc": "本次入口仅调用一次公共场景导航；返回入口后必须正面识别活动菜单，不重复导航",
        "recognition": {"type": "DirectHit"},
        "anchor": {"ClaimEventRewardsNavigation": ""},
        "next": ["SceneAnyEnterEventsMenu"],
        "on_error": ["ClaimEventRewardsFailed"],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "ClaimEventRewardsInMenu": {
        "desc": "已在目标页则直接检查七格；否则优先选可见完整名称，目标不可见时才做有限边界扫描",
        "recognition": {"type": "And", "param": {"all_of": ["InEventsMenu"]}},
        "next": [
            "ClaimEventRewardsPageReady",
            "ClaimEventRewardsEventTab",
            "ClaimEventRewardsScanSidebar"
        ],
        "on_error": ["ClaimEventRewardsUnverifiedList"],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "ClaimEventRewardsScanSidebar": {
        "desc": "复用有限侧栏扫描动作；默认只回目标标签，只有动作证明完整扫描无目标才受控改道NoEvent",
        "recognition": {
            "type": "And",
            "param": {"all_of": ["InEventsMenu", "ClaimEventRewardsScanHeader"]}
        },
        "action": {"type": "Custom", "param": {"custom_action": "claim_event_rewards_scan"}},
        "next": ["ClaimEventRewardsEventTab"],
        "on_error": ["ClaimEventRewardsFailed"],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "ClaimEventRewardsScanHeader": {
        "recognition": {
            "type": "OCR",
            "param": {"roi": [28, 109, 153, 44], "expected": ["限时"], "threshold": 0.8}
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "ClaimEventRewardsScanNames": {
        "desc": "不筛选目标名称；扫描动作必须检查原始all_results，低可信、裁切或疑似目标均失败",
        "recognition": {
            "type": "OCR",
            "param": {"roi": [75, 157, 124, 460], "expected": [], "threshold": 0.8}
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "ClaimEventRewardsScanUp": {
        "desc": "向列表顶部移动：单次向下拖动300px，保留160px重叠；由扫描动作核验前后名单",
        "recognition": {
            "type": "And",
            "param": {"all_of": ["InEventsMenu", "ClaimEventRewardsScanHeader"]}
        },
        "action": {
            "type": "Swipe",
            "param": {"begin": [140, 248, 12, 12], "end": [140, 548, 12, 12], "duration": 300}
        },
        "post_wait_freezes": {"time": 150, "target": [75, 157, 124, 460], "rate_limit": 0},
        "next": [],
        "on_error": [],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "ClaimEventRewardsScanDown": {
        "desc": "向列表底部移动：单次向上拖动300px，保留160px重叠；没有识别或动作成功就不能判定边界",
        "recognition": {
            "type": "And",
            "param": {"all_of": ["InEventsMenu", "ClaimEventRewardsScanHeader"]}
        },
        "action": {
            "type": "Swipe",
            "param": {"begin": [140, 548, 12, 12], "end": [140, 248, 12, 12], "duration": 300}
        },
        "post_wait_freezes": {"time": 150, "target": [75, 157, 124, 460], "rate_limit": 0},
        "next": [],
        "on_error": [],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "ClaimEventRewardsEventTab": {
        "desc": "在可见侧栏识别完整活动名称后仅点击一次；ROI覆盖当前可见列表，不假设完整列表已扫描",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["InEventsMenu", "ClaimEventRewardsEventTabText"],
                "box_index": 1
            }
        },
        "action": {"type": "Click"},
        "post_wait_freezes": {
            "time": 150,
            "target": [703, 270, 548, 365],
            "rate_limit": 0
        },
        "next": ["ClaimEventRewardsPageReady"],
        "on_error": ["ClaimEventRewardsFailed"],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "ClaimEventRewardsEventTabText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [76, 154, 118, 454],
