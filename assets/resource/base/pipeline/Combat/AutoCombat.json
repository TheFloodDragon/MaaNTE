{
    "AutoCombatMain": {
        "desc": "自动战斗入口：按全局战斗配置执行一场战斗。确认结束（cleared/disengaged）或目标丢失（target_lost）视为本轮交还成功；持续模式下 next 被选项改为指回自身、重新等待新的敌人。撤退、超时、HUD/截图异常、出错均走失败，结束任务，不会在撤退后立即重开",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "combat_run",
                "custom_action_param": {
                    "option_nodes": [
                        "AutoCombat_ModeOption",
                        "AutoCombat_WaitTimeoutOption",
                        "AutoCombat_MaxDurationOption"
                    ],
                    "accepted_reasons": [
                        "cleared",
                        "disengaged",
                        "target_lost"
                    ]
                }
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": []
    },
    "AutoCombat_ModeOption": {
        "desc": "选项载体：运行模式（持续模式写入 wait_timeout=0）",
        "enabled": false,
        "attach": {}
    },
    "AutoCombat_WaitTimeoutOption": {
        "desc": "选项载体：单次模式的进战等待时间（秒）",
        "enabled": false,
        "attach": {}
    },
    "AutoCombat_MaxDurationOption": {
        "desc": "选项载体：单场战斗最长时长（秒，0 为不限）",
        "enabled": false,
        "attach": {}
    }
}
