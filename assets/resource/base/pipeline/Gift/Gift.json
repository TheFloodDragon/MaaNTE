{
    "GiftEntry": {
        "desc": "清空本轮状态并逐角色读取独立配置；不复用上次额度或发送意图",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_reset"
            }
        },
        "next": [
            "GiftEnsureBond"
        ],
        "on_error": [
            "GiftNavigationFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftEnsureBond": {
        "desc": "只通过公共场景接口进入羁遇；到达后再次识别",
        "next": [
            "GiftBondReady",
            "[JumpBack]SceneAnyEnterBondMenu"
        ],
        "on_error": [
            "GiftNavigationFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftBondReady": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InBondMenu"
                ]
            }
        },
        "next": [
            "GiftOpenTab"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftOpenTab": {
        "desc": "切到「赠礼」页签；之后在页签内切换角色",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_open_tab"
            }
        },
        "next": [
            "GiftWaitGiftPage"
        ],
        "on_error": [
            "GiftNavigationFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftWaitGiftPage": {
        "desc": "只观察直到出现「赠送n/3」按钮",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_wait_gift_page"
            }
        },
        "next": [
            "GiftWaitGiftPage"
        ],
        "on_error": [
            "GiftNavigationFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftChooseCharacter": {
        "desc": "依次点侧栏头像，名称框显示目标角色才继续；侧栏到底仍未找到则跳过该角色",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_choose_character"
            }
        },
        "next": [
            "GiftWaitCharacter"
        ],
        "on_error": [
            "GiftWarnCurrent"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftWaitCharacter": {
        "desc": "只观察名称框直到稳定；绝不重放点击",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_wait_character"
            }
        },
        "next": [
            "GiftWaitCharacter"
        ],
        "on_error": [
            "GiftWarnCurrent"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftScroll": {
        "desc": "在侧栏或礼物格滚轮一次；只以滚动前后画面不变判定到顶/到底",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_scroll"
            }
        },
        "next": [
            "GiftWaitScroll"
        ],
        "on_error": [
            "GiftWarnCurrent"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftWaitScroll": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_wait_scroll"
            }
        },
        "next": [
            "GiftWaitScroll"
        ],
        "on_error": [
            "GiftWarnCurrent"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftCheckQuota": {
        "desc": "以游戏「赠送n/3」换算当日已送，不将每次启动视为额外配额",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_check_quota"
            }
        },
        "next": [
            "GiftFindGift"
        ],
        "on_error": [
            "GiftWarnCurrent"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftFindGift": {
        "desc": "仅找当前优先礼物；礼物格从顶到底逐格核对仍没有才换备选",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_find_gift"
            }
        },
        "next": [
            "GiftVerifyGift"
        ],
        "on_error": [
            "GiftWarnCurrent"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftVerifyGift": {
        "desc": "点选后只观察「当前选择」名称直到稳定；不凭图标相似发送",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_verify_gift"
            }
        },
        "next": [
            "GiftSendOne"
        ],
        "on_error": [
            "GiftWarnCurrent"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftSendOne": {
        "desc": "新截图通过所有安全门后先建立pending，再且仅再点一次「赠送」；失败只能进回执失败分支",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_send_one"
            }
        },
        "next": [
            "GiftWaitReceipt"
        ],
        "on_error": [
            "GiftReceiptFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftWaitReceipt": {
        "desc": "只观察，不发送；常规礼物计数恰好减1、不占次数礼物出现好感提示才计为成功",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_wait_receipt"
            }
        },
        "next": [
            "GiftWaitReceipt"
        ],
        "on_error": [
            "GiftReceiptFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftReceiptFailed": {
        "desc": "回执缺失或控制器结果不明：撤销pending并锁定当前角色，绝不回放发送",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_receipt_failed"
            }
        },
        "next": [
            "GiftWarnCurrent"
        ],
        "on_error": [
            "GiftNavigationFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftWarnCurrent": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_warn_current"
            }
        },
        "next": [
            "GiftRecoverCurrent"
        ],
        "on_error": [
            "GiftNavigationFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftRecoverCurrent": {
        "desc": "只识别已知页面/加载；未知弹窗不点确定、不盲按Esc，无法恢复则汇总其余警告",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_recover_current"
            }
        },
        "next": [
            "GiftNextCharacter"
        ],
        "on_error": [
            "GiftNavigationFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftNextCharacter": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_next_character"
            }
        },
        "next": [
            "GiftChooseCharacter"
        ],
        "on_error": [
            "GiftNavigationFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftNavigationFailed": {
        "desc": "停止一切输入，为剩余角色记无法执行警告，并让任务以失败结束",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_navigation_failed"
            }
        },
        "next": [
            "GiftSummary"
        ],
        "on_error": [
            "GiftFailed"
        ],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftSummary": {
        "desc": "汇总结果；有角色无法完成或结果不明时转到 GiftFailed",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "gift_summary"
            }
        },
        "next": [],
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftScrollWheel": {
        "desc": "供 gift_scroll 调用：光标先移到 target 再滚轮一次；target/dy 由代码按区域覆盖，不在任何 next 中",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Scroll",
            "param": {
                "target": [
                    0,
                    0,
                    1,
                    1
                ],
                "dy": 0
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftFailed": {
        "desc": "让 MXU 显示任务失败；警告与汇总已在前面输出",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "fail_task"
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Action.Failed": "羁遇赠礼未全部完成，请查看上方警告"
        }
    }
}
