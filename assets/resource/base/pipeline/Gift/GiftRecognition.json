{
    "GiftBondMarker": {
        "desc": "羁遇页标记；仅使用固定上游图集的720p局部裁剪，来源见Gift/UI/source.json",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Gift/UI/BondPanel.png",
                "roi": [8, 8, 88, 78],
                "threshold": 0.9
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftInfiniteMarker": {
        "desc": "礼物格左上角的∞徽记；视觉层只在选中格的徽记区内检测（ROI 由代码覆盖）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Gift/UI/InfiniteGift.png",
                "roi": [660, 260, 450, 230],
                "threshold": 0.9
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftLoadingMarker": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Common/Scene/SceneLoading.png",
                "threshold": 0.9
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftTabOCR": {
        "desc": "羁遇页右上角的「赠礼」页签（ok-nte 实测点 0.802,0.124）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [936, 60, 174, 58],
                // @i18n-skip 完整名称锚定；未核实的游戏译名不编造
                "expected": ["^赠礼$", "^贈禮$"],
                "threshold": 0.9
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftCharacterNameOCR": {
        "desc": "名称框；可能同时含等级/称号，Python 要求恰好一个结果是完整角色名",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [671, 106, 289, 54],
                "threshold": 0.3
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftQuotaOCR": {
        "desc": "赠送按钮文字「赠送n/3」；合并或拆分为「赠送」+「n/3」都接受，命中框即发送按钮",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [754, 549, 168, 36],
                "threshold": 0.3
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftCurrentSelectionOCR": {
        "desc": "点选礼物后「当前选择」处的完整礼物名；礼物身份唯一授权证据。ROI 待实机校准",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [660, 170, 460, 160],
                "threshold": 0.3
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftAffectionOCR": {
        "desc": "送礼后的提示「【角色】的好感度提升了N点。」；不占次数礼物的回执证据。ROI 待实机校准",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [240, 60, 800, 220],
                "threshold": 0.3
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftLimitPromptOCR": {
        "desc": "游戏限制提示：今日赠礼次数已用完 / 对方今日无法接受更多的礼物 / 提升羁遇等级后才能继续赠送礼物",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [240, 60, 850, 540],
                "threshold": 0.3
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftUnexpectedDialogOCR": {
        "desc": "底层羁遇仍可见时识别未知确认/购买/解锁/提交按钮；仅作阻断，绝不通用确定",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [240, 150, 850, 380],
                "threshold": 0.5
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftGlobalLimitOCR": {
        "desc": "只认明确指向全角色总额度的完整限制文案，不把单角色额度当全局",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [240, 60, 850, 540],
                "expected": ["今日赠礼次数已用完", "今日贈禮次數已用完"],
                "threshold": 0.9
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    }
}
