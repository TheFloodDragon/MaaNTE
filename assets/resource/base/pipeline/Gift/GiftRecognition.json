{
    "GiftBondMarker": {
        "desc": "羁遇页标记；仅使用固定上游图集的720p局部裁剪，来源见Gift/UI/source.json",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Gift/UI/BondPanel.png",
                "roi": [8, 8, 88, 78],
                "threshold": 0.9
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GiftInfiniteMarker": {
        "desc": "无限徽记；只作保守拦截，不据此推断库存或赠礼语义",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Gift/UI/InfiniteGift.png",
                "roi": [560, 165, 565, 425],
                "threshold": 0.9
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
