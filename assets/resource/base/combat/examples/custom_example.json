// 自定义战斗方案示例。复制到安装目录 config/combat/ 下改名后，在「设置 → 任务设置 → 战斗配置」
// 选择「自定义方案」并填写文件名。出招表语法见 docs/zh_cn/introduction/AutoCombat.md。
{
    "version": 1,
    "name": "自定义方案示例",
    "description": "演示冲刺、带方向闪避、斜向移动、锁敌、转视角、切人与按住类指令",
    // team 只用于开战前提示：请自行按此编队，脚本不会检查
    "team": [
        {
            "slot": 1,
            "character": "零",
            "note": "主C"
        },
        {
            "slot": 2,
            "character": "薄荷"
        }
    ],
    "combos": {
        // 1 号位：先锁敌、放 Q，冲刺贴近后跳起普攻，再斜向走位接 E 和重击
        "1": [
            "lock, ultimate",
            "sprint(0.6), jump, l_click(1)",
            "walk(wa, 0.3), skill, heavy(0.8)"
        ],
        // 2 号位：放 E 后向后闪避，普攻一会儿，把视角向右转 45 度，再在出招表里直接切回 1 号位
        "2": [
            "skill(0.3), dodge(s)",
            "l_click(0.5), turn(45), switch(1)"
        ],
        // 其余槽位通用
        "default": "arc, ultimate, skill, l_click(1)"
    },
    "rotation": {
        "mode": "cycle",
        "order": [
            1,
            2
        ],
        "min_field_time": 1.0
    }
}
